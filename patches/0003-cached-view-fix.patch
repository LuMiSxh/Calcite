+    accessed_element_states_start: Option<usize>,
 }
 
 #[derive(Default)]
@@ -412,6 +415,7 @@ impl<V: View> Element for ViewElement<V> {
                     !known || window.dirty_views.contains(&entity_id) || window.refreshing;
 
                 if should_probe {
+                    let accessed_element_states_start = window.accessed_element_states_len();
                     let ((element, detached_layout_id), accessed_entities) = cx
                         .detect_accessed_entities(|cx| {
                             let mut element = render_view(self.view.take().unwrap(), window, cx);
@@ -430,6 +434,7 @@ impl<V: View> Element for ViewElement<V> {
                             element: Some(element),
                             detached_layout_id: Some(detached_layout_id),
                             accessed_entities,
+                            accessed_element_states_start: Some(accessed_element_states_start),
                         },
                     );
                 }
@@ -509,7 +514,13 @@ impl<V: View> Element for ViewElement<V> {
                         }
 
                         let refreshing = mem::replace(&mut window.refreshing, true);
-                        let prepaint_start = window.prepaint_index();
+                        let mut prepaint_start = window.prepaint_index();
+                        if let Some(start) = request_layout.accessed_element_states_start.take() {
+                            Window::extend_prepaint_range_from_accessed_element_states(
+                                &mut prepaint_start,
+                                start,
+                            );
+                        }
                         let mut accessed_entities =
                             mem::take(&mut request_layout.accessed_entities);
                         let (element, additional_entities) = cx.detect_accessed_entities(|cx| {
diff --git a/crates/gpui/src/window.rs b/crates/gpui/src/window.rs
index 3302cb9b53..86a4686189 100644
--- a/crates/gpui/src/window.rs
+++ b/crates/gpui/src/window.rs
@@ -2321,6 +2321,19 @@ mod content_mask_tests {
 }
 
 impl Window {
+    /// How many element states this frame has accessed so far. A cached view records it
+    /// before rendering in `request_layout`, so the states its render touches join its reuse range.
+    pub(crate) fn accessed_element_states_len(&self) -> usize {
+        self.next_frame.accessed_element_states.len()
+    }
+
+    pub(crate) fn extend_prepaint_range_from_accessed_element_states(
+        range_start: &mut PrepaintStateIndex,
+        accessed_element_states_index: usize,
+    ) {
+        range_start.accessed_element_states_index = accessed_element_states_index;
+    }
+
     fn mark_view_dirty(&mut self, view_id: EntityId) {
         // Mark ancestor views as dirty. If already in the `dirty_views` set, then all its ancestors
         // should already be dirty.
