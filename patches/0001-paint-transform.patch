+    /// Runs `f` with a uniform paint-time transform: everything painted inside is scaled by
+    /// `scale` about `origin` (a point in the coordinates painted inside, window space). Layout,
+    /// hit-testing and hitboxes are unaffected; glyph, SVG and image sprites keep their original
+    /// raster and are scaled on the GPU. Nested transforms compose (the inner one applies first).
+    /// Content masks are not transformed. This method should only be called during paint.
+    pub fn with_paint_transform<R>(
+        &mut self,
+        scale: f32,
+        origin: Point<Pixels>,
+        f: impl FnOnce(&mut Self) -> R,
+    ) -> R {
+        self.invalidator.debug_assert_paint();
+        let previous = self.paint_transform;
+        self.paint_transform = previous.then(PaintTransform::about(scale, origin));
+        let result = f(self);
+        self.paint_transform = previous;
+        result
+    }
+
+    /// The composed transform of the enclosing [`Self::with_paint_transform`] scopes.
+    pub fn paint_transform(&self) -> PaintTransform {
+        self.paint_transform
+    }
+
+    /// Device-space `(scale, translation)` of the paint transform, or `None` for identity.
+    fn device_paint_transform(&self) -> Option<(f32, Point<ScaledPixels>)> {
+        let transform = self.paint_transform;
+        if transform.is_identity() {
+            return None;
+        }
+        let factor = self.scale_factor();
+        Some((
+            transform.scale,
+            point(
+                ScaledPixels(transform.translation.x.0 * factor),
+                ScaledPixels(transform.translation.y.0 * factor),
+            ),
+        ))
+    }
+
+    fn transform_bounds(&self, bounds: Bounds<ScaledPixels>) -> Bounds<ScaledPixels> {
+        let Some((scale, translation)) = self.device_paint_transform() else {
+            return bounds;
+        };
+        Bounds {
+            origin: point(
+                bounds.origin.x * scale + translation.x,
+                bounds.origin.y * scale + translation.y,
+            ),
+            size: size(bounds.size.width * scale, bounds.size.height * scale),
+        }
+    }
+
+    fn transform_length(&self, length: ScaledPixels) -> ScaledPixels {
+        length * self.paint_transform.scale
+    }
+
+    fn transform_corners(&self, corners: Corners<ScaledPixels>) -> Corners<ScaledPixels> {
+        corners.map(|radius| self.transform_length(*radius))
+    }
+
+    fn transform_edges(&self, edges: Edges<ScaledPixels>) -> Edges<ScaledPixels> {
+        edges.map(|width| self.transform_length(*width))
+    }
+
+    /// Lowers logical filters to device space and applies the paint transform to them.
+    fn scale_filters(&self, filters: &[Filter]) -> SmallVec<[ScaledFilter; 4]> {
+        let scale_factor = self.scale_factor();
+        let transform = self.device_paint_transform();
+        filters
+            .iter()
+            .filter(|filter| !filter.is_identity())
+            .map(|filter| {
+                let scaled = filter.scale(scale_factor);
+                match transform {
+                    Some((scale, translation)) => {
+                        scaled.transformed(scale, [translation.x.0, translation.y.0])
+                    }
+                    None => scaled,
+                }
+            })
+            .collect()
+    }
