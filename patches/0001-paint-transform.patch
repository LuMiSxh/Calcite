+impl Path<ScaledPixels> {
+    /// Applies the uniform paint transform `p' = scale * p + translation` (device pixels).
+    /// Curve coordinates are unaffected, so the path rasterises identically at the new size.
+    pub fn transform(&mut self, scale: f32, translation: Point<ScaledPixels>) {
+        let map = |point: Point<ScaledPixels>| Point {
+            x: point.x * scale + translation.x,
+            y: point.y * scale + translation.y,
+        };
+        self.bounds = Bounds {
+            origin: map(self.bounds.origin),
+            size: Size {
+                width: self.bounds.size.width * scale,
+                height: self.bounds.size.height * scale,
+            },
+        };
+        for vertex in &mut self.vertices {
+            vertex.xy_position = map(vertex.xy_position);
+        }
+        self.start = map(self.start);
+        self.current = map(self.current);
+    }
+}
