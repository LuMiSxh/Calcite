+/// A uniform scale plus translation applied to everything painted inside
+/// [`Window::with_paint_transform`]: `p' = scale * p + translation`, in logical pixels.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct PaintTransform {
+    /// Uniform scale factor.
+    pub scale: f32,
+    /// Translation applied after scaling, in logical pixels.
+    pub translation: Point<Pixels>,
+}
+
+impl PaintTransform {
+    /// The transform that changes nothing.
+    pub const IDENTITY: Self = Self {
+        scale: 1.0,
+        translation: Point {
+            x: Pixels(0.0),
+            y: Pixels(0.0),
+        },
+    };
+
+    /// Scales by `scale` about the fixed point `origin`.
+    pub fn about(scale: f32, origin: Point<Pixels>) -> Self {
+        Self {
+            scale,
+            translation: point(origin.x * (1.0 - scale), origin.y * (1.0 - scale)),
+        }
+    }
+
+    /// The transform that applies `inner` first and then `self`.
+    pub fn then(self, inner: Self) -> Self {
+        Self {
+            scale: self.scale * inner.scale,
+            translation: point(
+                inner.translation.x * self.scale + self.translation.x,
+                inner.translation.y * self.scale + self.translation.y,
+            ),
+        }
+    }
+
+    /// Transforms a point.
+    pub fn apply(&self, p: Point<Pixels>) -> Point<Pixels> {
+        point(
+            p.x * self.scale + self.translation.x,
+            p.y * self.scale + self.translation.y,
+        )
+    }
+
+    /// Whether this transform changes nothing.
+    pub fn is_identity(&self) -> bool {
+        *self == Self::IDENTITY
+    }
+}
