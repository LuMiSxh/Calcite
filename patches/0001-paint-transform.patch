+    struct PaintTransformSceneView;
+
+    impl Render for PaintTransformSceneView {
+        fn render(&mut self, _window: &mut Window, _cx: &mut Context<Self>) -> impl IntoElement {
+            canvas(
+                |_, _, _| (),
+                |_, _, window, _| {
+                    let bounds = Bounds::new(point(px(10.), px(10.)), size(px(20.), px(20.)));
+                    let styled = || {
+                        quad(
+                            bounds,
+                            px(8.),
+                            crate::blue(),
+                            px(4.),
+                            crate::white(),
+                            BorderStyle::Solid,
+                        )
+                    };
+                    window.paint_quad(styled());
+                    window.with_paint_transform(0.5, point(px(10.), px(10.)), |window| {
+                        window.paint_quad(styled());
+                        window.with_paint_transform(2.0, point(px(0.), px(0.)), |window| {
+                            window.paint_quad(styled());
+                        });
+                    });
+                    window.paint_quad(styled());
+                },
+            )
+            .size_full()
+        }
+    }
+
+    #[gpui::test]
+    fn paint_transform_scales_primitives_and_leaves_the_rest_alone(cx: &mut TestAppContext) {
+        let window = cx.add_window(|_, _| PaintTransformSceneView);
+        window
+            .update(cx, |_, window, _| {
+                let sf = window.scale_factor();
+                let scene = &window.rendered_frame.scene;
+                let quads: Vec<_> = scene.quads.iter().collect();
+                assert_eq!(quads.len(), 4);
+                let rect = |quad: &Quad| {
+                    [
+                        quad.bounds.origin.x.0 / sf,
+                        quad.bounds.origin.y.0 / sf,
+                        quad.bounds.size.width.0 / sf,
+                        quad.bounds.size.height.0 / sf,
+                    ]
+                };
+                // Untransformed before and after the scope: identical, exact.
+                assert_eq!(rect(quads[0]), [10., 10., 20., 20.]);
+                assert_eq!(rect(quads[3]), [10., 10., 20., 20.]);
+                assert_eq!(quads[0].corner_radii.top_left.0, 8. * sf);
+                assert_eq!(quads[0].border_widths.top.0, 4. * sf);
+                // 0.5 about (10, 10): the corner stays, size, radius and border halve.
+                assert_eq!(rect(quads[1]), [10., 10., 10., 10.]);
+                assert_eq!(quads[1].corner_radii.top_left.0, 4. * sf);
+                assert_eq!(quads[1].border_widths.top.0, 2. * sf);
+                // Nested 2.0 about the origin inside 0.5 about (10, 10): net scale 1, shift 5.
+                assert_eq!(rect(quads[2]), [15., 15., 20., 20.]);
+                assert_eq!(quads[2].corner_radii.top_left.0, 8. * sf);
+            })
+            .unwrap();
+    }
