From: Calcite <calcite@users.noreply.github.com>
Date: Fri, 16 Oct 2026 22:16:10 +0200
Subject: [PATCH 3/3] fix(view): carry element states of a reused cached view

A cached view reuses its prepaint range without the element states it created while rendering.
Also fill the new Quad fields in the debug overlay.

diff --git a/crates/gpui/src/debug_overlay.rs b/crates/gpui/src/debug_overlay.rs
index 7e580e840e..c1a10f97a3 100644
--- a/crates/gpui/src/debug_overlay.rs
+++ b/crates/gpui/src/debug_overlay.rs
@@ -220,12 +220,16 @@ fn solid_quad(
     Quad {
         order: 0,
         border_style: BorderStyle::Solid,
+        border_dashed_length: 0.0,
+        border_dashed_gap: 0.0,
         bounds,
         content_mask: *content_mask,
         background: color.into(),
         border_color: transparent_black().into(),
         corner_radii: Corners::default(),
         border_widths: Edges::default(),
+        corner_smoothing: 0.0,
+        padding: 0,
     }
 }
 
diff --git a/crates/gpui/src/view.rs b/crates/gpui/src/view.rs
