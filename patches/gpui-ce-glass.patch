+
+/// CPU reference of the shader's rounded-rectangle signed distance. `radii` is
+/// `[top_left, top_right, bottom_right, bottom_left]`.
+pub fn rounded_rect_signed_distance(
+    point: [f32; 2],
+    origin: [f32; 2],
+    size: [f32; 2],
+    radii: [f32; 4],
+) -> f32 {
+    let half = [size[0] * 0.5, size[1] * 0.5];
+    let to_point = [
+        point[0] - origin[0] - half[0],
+        point[1] - origin[1] - half[1],
+    ];
+    let radius = match (to_point[0] < 0.0, to_point[1] < 0.0) {
+        (true, true) => radii[0],
+        (false, true) => radii[1],
+        (false, false) => radii[2],
+        (true, false) => radii[3],
+    };
+    let q = [
+        to_point[0].abs() - half[0] + radius,
+        to_point[1].abs() - half[1] + radius,
+    ];
+    if radius == 0.0 {
+        q[0].max(q[1])
+    } else {
+        (q[0].max(0.0).powi(2) + q[1].max(0.0).powi(2)).sqrt() + q[0].max(q[1]).min(0.0) - radius
+    }
+}
