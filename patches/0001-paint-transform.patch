+    #[test]
+    fn paint_transforms_compose_inner_first() {
+        let outer = PaintTransform::about(0.5, point(px(10.), px(10.)));
+        let inner = PaintTransform::about(2.0, point(px(0.), px(0.)));
+        let composed = outer.then(inner);
+
+        // The origin of a transform is its fixed point.
+        assert_eq!(
+            outer.apply(point(px(10.), px(10.))),
+            point(px(10.), px(10.))
+        );
+        assert_eq!(composed.scale, 1.0);
+        for p in [point(px(0.), px(0.)), point(px(30.), px(-4.))] {
+            assert_eq!(composed.apply(p), outer.apply(inner.apply(p)));
+        }
+        assert!(PaintTransform::IDENTITY.is_identity());
+        assert!(!outer.is_identity());
+        assert_eq!(PaintTransform::IDENTITY.then(outer), outer);
+    }
